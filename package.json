{
  "name": "careerpilot-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CareerPilot API (Node.js + TypeScript): jobs, email templates, Gmail sending, resumes, docEngine PDFs, Google Drive.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "domhandler": "^5.0.3",
    "htmlparser2": "^10.0.0",
    "jose": "^5.9.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "@prisma/client": "^6.16.0",
    "puppeteer": "^24.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.16.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

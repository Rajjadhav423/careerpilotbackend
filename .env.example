# Copy to .env and fill in. Never commit .env.

# Port the API listens on
PORT=8080

# PostgreSQL (Prisma). Neon: DATABASE_URL = the pooled connection string with &pgbouncer=true added;
# DIRECT_URL = the direct (non-pooled) one, used by migrations. Locally both can be the same.
DATABASE_URL=postgres://careerpilot:password@localhost:5432/careerpilot
DIRECT_URL=postgres://careerpilot:password@localhost:5432/careerpilot
# Only for tests: a separate database that the tests may empty
TEST_DATABASE_URL=postgres://careerpilot:password@localhost:5432/careerpilot_test

# Clerk Frontend API URL (the session token's "iss"), e.g. https://xxxx.clerk.accounts.dev
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Frontend origins allowed in the token's "azp" claim (comma-separated)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Webhook signing secret (Clerk Dashboard -> Webhooks), "whsec_..." — empty = webhooks disabled (503)
CLERK_WEBHOOK_SECRET=
# Clerk secret key "sk_..." — server only; needed for Gmail sending and Google Drive (reads the user's Google token)
CLERK_SECRET_KEY=

# Frontend origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Largest request body in bytes (default 512 KB)
MAX_REQUEST_BYTES=524288

# Resume version history (History dialog, suggestions). Off keeps the database small.
RESUME_VERSIONS_ENABLED=false

# PDF engine limits
PDF_MAX_PAGES=10
PDF_MAX_BYTES=5242880
PDF_RENDER_TIMEOUT_MS=20000
PDF_MAX_CONCURRENT=2
PDF_MAX_QUEUED=8

# Job discovery boards (provider:slug:Company Name, comma-separated). Empty = the built-in list.
DISCOVERY_BOARDS=

